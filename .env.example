# Database (postgres existente na VPS)
DATABASE_URL=postgresql+psycopg://dbuser:SENHA@postgres:5432/rewards_db

# Debug / logging (opcional, default false — não usar true em produção)
DEBUG=false

# Security
SECRET_KEY=GERE_UMA_CHAVE_FORTE_AQUI
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — domínio do frontend em produção
CORS_ORIGINS=["https://rewards.strokes.dev.br"]

# API_V1
API_V1_PREFIX=/api/v1

# ROOT_PATH — preencher em produção quando o Nginx Proxy Manager encaminhar
# api.strokes.dev.br/rewards/ para este container (com strip do prefixo).
# Deixar vazio em desenvolvimento local.
ROOT_PATH=/rewards

# Frontend build arg
VITE_API_URL=https://api.strokes.dev.br/rewards/api/v1

# Push Notifications (VAPID)
VAPID_PRIVATE_KEY=GERAR_E_COLAR_AQUI
VAPID_PUBLIC_KEY=GERAR_E_COLAR_AQUI
VAPID_ADMIN_EMAIL=xxxx
PUSH_ADMIN_SECRET=GERAR_STRING_FORTE_AQUI